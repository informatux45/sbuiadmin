backdoor/inc/admin/dashboard.txt
backdoor/inc/admin/settings.txt
backdoor/inc/admin/theme.txt
backdoor/datas/cache/core/
backdoor/datas/cache/medias/
backdoor/datas/cache/tpls_c/
datas/cache/core/
datas/cache/medias/
datas/cache/tpls_c/

# Marqueur de fin d'installation, propre à chaque installation. NE JAMAIS
# le committer : présent dans une archive téléchargée, il refermerait
# l'assistant d'installation (voir backdoor/install/inc-auth-guard.php)
# avant même la première installation.
backdoor/install/installer/installer.lock

# Nom de la session PHP, tiré au sort à l'installation. Propre à chaque
# installation : le committer ferait partager le même nom de cookie à tous
# les sites issus de cette archive, ce qui est exactement le problème que ce
# mécanisme corrige (voir inc/sbsession.php).
inc/sbsession.txt

# Généré à l'exécution
sitemap.xml

# Fichiers déposés depuis l'admin. Le contenu de démo livré avec le CMS
# (informatux.png, news-*.jpg, slider-*.jpg, .htaccess) reste suivi.
upload/*
!upload/.htaccess
!upload/informatux.png
!upload/news-*.jpg
!upload/slider-*.jpg
!upload/avatars/
upload/avatars/*
!upload/avatars/.gitkeep

# Librairie mise de côté (désactivée en renommant le fichier)
backdoor/assets/dist/js/vendor/tagify/_tagify.min.js_
# Interrupteur de secours de la double authentification (voir
# backdoor/inc/sbuiadmin-2fa.php) : propre à un serveur, jamais versionné.
backdoor/inc/admin/2fa-disabled

# Accès à la base et clé de chiffrement des secrets (voir
# backdoor/inc/sbuiadmin-settings.php), et copies de l'ancien settings.txt
# faites à la migration. Propres à chaque installation : NE JAMAIS committer.
sbdbconfig.php
sbsettings-backup-*.php
