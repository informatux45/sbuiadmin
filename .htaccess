## Caching schema
 <FilesMatch "\.(jpg|png|css|js)$">
 Header set Cache-Control "proxy-revalidate, max-age=3600"
 </FilesMatch>

## Point 1 (audit sécurité, 2026-07-29) : en-têtes HTTP de sécurité de base.
## Pas de Content-Security-Policy/Strict-Transport-Security ici - ces 2-là
## peuvent casser des choses (CDN externes, mode HTTP local...) sans un
## réglage plus fin au cas par cas, volontairement laissés de côté.
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

 ## Error Document
 ErrorDocument 404 index.php?p=pages&id=404

## Prevent viewing of .htaccess file
<Files .htaccess>
order allow,deny
deny from all
</Files>

## Nom de la session de cette installation (voir inc/sbsession.php).
## Ce n'est pas un secret - un nom de cookie voyage en clair dans chaque
## en-tete Set-Cookie - mais rien ne justifie de le servir comme un fichier.
<Files sbsession.txt>
order allow,deny
deny from all
</Files>

## Fichiers cachés : .gitignore, .user.ini, .env, et tout ce qui commence par
## un point. Ne bloque QUE des fichiers, jamais un répertoire : la validation
## Let's Encrypt (.well-known/acme-challenge/<jeton>) continue de fonctionner,
## le nom du fichier servi n'y commence pas par un point.
## Attention en élargissant cette règle : ne jamais bloquer .txt en bloc,
## robots.txt et les fichiers de vérification des moteurs doivent rester servis.
<FilesMatch "^\.">
order allow,deny
deny from all
</FilesMatch>

## Prevent directory listings
Options All -Indexes

###########################################################
#######                  Rewrite URL                #######
###########################################################
## On suit les liens symboliques
Options +FollowSymlinks
## Activation du mod rewrite d'Apache
RewriteEngine On

## Répertoires cachés d'outils : dépôt git (présent dans la racine web dès
## qu'on déploie par "git pull" plutôt que par transfert de fichiers), et les
## dossiers de configuration d'éditeurs ou d'assistants.
## Un <FilesMatch "^\."> ne suffit PAS ici : il faut interdire tout ce qui est
## SOUS ces répertoires (.git/config, .git/HEAD, refs, objects...), et ces
## fichiers-là ne commencent pas par un point. La règle générique plus bas ne
## les protège pas davantage : elle ne redirige vers index.php que ce qui
## n'existe PAS sur le disque - or .git/config existe bel et bien, donc Apache
## le servait tel quel.
RewriteRule (^|/)\.(git|svn|hg|bzr|claude|idea|vscode)(/|$) - [F,L]

## Réécriture de index.html vers index.php
RewriteRule ^index\.html$ index.php

<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteRule ^index\.php$ - [L]
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule . index.php [L]
</IfModule>

